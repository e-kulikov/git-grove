#!/usr/bin/env bash
# Rejects a commit message that breaks the rules in committed.toml.
# Installed by scripts/install-git-hooks.sh.
set -euo pipefail

# A merge's message is generated by git and is not a Conventional Commit.
if git rev-parse --quiet --verify MERGE_HEAD >/dev/null; then
  exit 0
fi
if ! command -v committed >/dev/null; then
  echo "committed is not installed; run 'mise install' (see README)" >&2
  exit 1
fi
exec committed --commit-file "$1"
